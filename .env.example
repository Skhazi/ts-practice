# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# In CI, do not create a .env file. Inject these as masked secrets/environment
# variables instead; the loader reads process.env either way.

# ---------------------------------------------------------------------------
# Environment under test
# ---------------------------------------------------------------------------
# Which environment profile to run against: stg | qa
TEST_ENV=stg

# Identity provider origin — the full login URL is composed in src/config/urls.ts
AUTH_BASE_URL=https://auth-stg.netgear.com
AUTH_THEME=insight

# Application under test — relative paths in tests resolve against this
APP_BASE_URL=https://pri-qa.insight.netgear.com

# ---------------------------------------------------------------------------
# Test accounts — values are secrets, keep them out of source control
# ---------------------------------------------------------------------------
STANDARD_USER_EMAIL=
STANDARD_USER_PASSWORD=

# Optional second account for role/permission tests
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Run options
# ---------------------------------------------------------------------------
HEADLESS=true
SLOW_MO=0
